---
import { getLanding } from '../content';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { footer: f } = getLanding(locale);
---

<footer class="shell">
  <!-- Statutory line, as designed: company, KvK, BTW, country. -->
  <p class="mono legal">
    <span class="op">{f.operatesAs}</span> · {f.kvk} · {f.btw} · {f.country}
  </p>
  <p class="mono">
    {f.builtWith} — <a href={f.sourceHref}>{f.sourceLabel}</a>.
  </p>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--page-pad) var(--space-5);
  }

  p {
    margin: 0;
  }

  /* Accent text: plum on Icing, raspberry on Liquorice. */
  .op {
    color: var(--color-accent);
  }
</style>
