---
import { getLanding } from '../content';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { footer: f, slogan } = getLanding(locale);
---

<footer>
  <p class="mono">
    {f.builtWith} — <a href={f.sourceHref}>{f.sourceLabel}</a>. <span class="op">{f.operatesAs}</span>
     — {slogan}
  </p>
</footer>

<style>
  footer {
    padding: var(--space-4) var(--page-pad) var(--space-5);
  }

  p {
    margin: 0;
  }

  /* Accent text: plum on Icing, raspberry on Liquorice. */
  .op {
    color: var(--color-accent);
  }
</style>
