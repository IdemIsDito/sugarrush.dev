---
import Wordmark from './Wordmark.astro';
import MenuSheet from './MenuSheet.astro';
import { useTranslations, altLocale, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  wordmark: string;
  resumeHref: string;
  resumeLabel: string;
}

const { locale, wordmark, resumeHref, resumeLabel } = Astro.props;
const other = altLocale(locale);
const tOther = useTranslations(other);
/* "sugarrush" + ".dev" — the tail carries the raspberry. */
const [lead = '', accent = ''] = wordmark.split(/(?=\.)/);
---

<header class="topbar shell">
  <Wordmark lead={lead} accent={accent} href="#main" />
  <MenuSheet locale={locale} lead={lead} accent={accent}>
    <div class="sheet-links">
      <a href={resumeHref}>{resumeLabel} <span aria-hidden="true">→</span></a>
      <a href={localePath(other)} hreflang={other} lang={other}>
        {tOther('locale.altPage')} <span aria-hidden="true">→</span>
      </a>
    </div>
  </MenuSheet>
</header>

<style>
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--topbar-height);
    padding: var(--space-4) var(--page-pad) 0;
  }

  .sheet-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }
</style>
